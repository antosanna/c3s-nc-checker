{
	"_comment": "This JSON file contains mandatory structure|information to be contained in  C3S NetCDF files - Seasonal",
	"_author": "C.Bergeron",
	"_source": "",


	"mandatory_cf_convention": "CF-1.6 C3S-0.1",
	"mandatory_netcdf_format": "NETCDF4_CLASSIC",
	"mandatory_number_datavariable_per_netcdf": 1,
	"mandatory_dimensions": ["lat", "lon"],
	"authorized_other_dimensions": ["plev", "depth", "height", "realization", "time", "time_bnds", "leadtime_bnds", "lat_bnds",
    "lon_bnds", "depth_bnds", "str31", "leadtime"],


	"mandatory_attributes_per_standardname": {
		"time": ["units", "calendar", "long_name", "standard_name"],
		"reftime": ["units", "calendar", "long_name", "standard_name"],
		"leadtime": ["units", "long_name", "standard_name"],
		"latitude": ["axis", "units", "long_name", "valid_min", "valid_max", "bounds", "standard_name"],
		"longitude": ["axis", "units", "long_name", "valid_min", "valid_max", "bounds", "standard_name"],
		"air_pressure": ["axis", "units", "long_name", "positive", "standard_name"],
		"depth": ["axis", "units", "long_name", "positive", "bounds", "standard_name"],
		"height": ["axis", "units", "long_name", "positive", "valid_min", "valid_max", "standard_name"],
		"realization": ["units", "axis", "standard_name", "long_name"]
	},




	"mandatory_attributes_values": {
		"calendar": ["gregorian"]

	},

	"mandatory_attributes_values_per_variablename": {

		"lat": {
			"units": "degrees_north",
			"long_name": "latitude",
            "standard_name" : "latitude",
			"dimensions": ["lat"],
			"axis": "Y",
			"valid_min": -90.0,
			"valid_max": 90.0,
			"bounds": "lat_bnds"
		},

		"lon": {
			"units": "degrees_east",
			"long_name": "longitude",
            "standard_name" : "longitude",
			"dimensions": ["lon"],
			"axis": "X",
			"valid_min": 0.0,
			"valid_max": 360.0,
			"bounds": "lon_bnds"
		},

		"plev": {
			"units": "Pa",
			"long_name": "pressure",
            "standard_name" : "air_pressure",
			"dimensions": ["plev"],
			"axis": "Z",
			"positive": "down"
		},

		"depth": {
			"units": "m",
			"long_name": "depth",
			"dimensions": ["depth"],
			"axis": "Z",
			"positive": "down"
		},

		"height": {
			"units": "m",
			"long_name": "height",
			"axis": "Z",
			"positive": "up"
		},

		"realization": {
			"units": "1",
			"long_name": "realization",
			"axis": "E",
            "standard_name" : "realization",
			"dimensions": ["str31"]
		},

		"reftime": {
			"long_name": "Start date of the forecast",
            "standard_name": "forecast_reference_time",
			"calendar": "gregorian"
		},

		"leadtime": {
			"long_name": "Time elapsed since the start of the forecast",
            "standard_name": "forecast_period",
			"dimensions": ["leadtime"],
			"bounds": "leadtime_bnds"
		},

		"time": {
			"long_name": "Verification time of the forecast",
			"dimensions": ["leadtime"],
			"calendar": "gregorian",
			"bounds": "time_bnds"
		},

        "hcrs": {
               "grid_mapping_name" : "latitude_longitude"
        },

		"sftlf": {
			"units": "1",
			"grid_mapping": "hcrs",
			"long_name": "Land Area Fraction",
			"coordinates": "lat lon",
			"valid_min": 0,
			"valid_max": 1,
			"dimensions": ["lat","lon"],
            "frequency":"fix",
            "level_type": "surface",
            "modeling_realm":"atmos"
